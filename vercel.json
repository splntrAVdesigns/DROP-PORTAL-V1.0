{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "DROP_PORTAL_PHASE1_CODEBASE_2026-09-21/dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/archive",
      "destination": "/archive/index.html"
    },
    {
      "source": "/archive/:id",
      "destination": "/archive/index.html"
    },
    {
      "source": "/saved",
      "destination": "/saved/index.html"
    }
  ],
  "functions": {
    "api/schedule.js": {
      "maxDuration": 30
    },
    "api/inquiry.js": {
      "maxDuration": 30
    },
    "api/drop-settings.js": {
      "maxDuration": 30
    },
    "api/admin-session.js": {
      "maxDuration": 10
    },
    "api/engine-stage.js": {
      "maxDuration": 30
    },
    "api/engine-publish.js": {
      "maxDuration": 30
    },
    "api/pipeline-status.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/weekly-feed/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
