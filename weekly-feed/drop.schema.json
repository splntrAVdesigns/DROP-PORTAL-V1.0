{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drop-portal.blang81.chatgpt.site/schema/weekly-drop-v1",
  "title": "DROP:PORTAL Weekly Drop",
  "type": "object",
  "required": ["schemaVersion", "drop", "tracks", "mixes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "drop": {
      "type": "object",
      "required": ["id", "sequenceNumber", "period", "ids", "publishedAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sequenceNumber": { "type": "integer", "minimum": 0 },
        "period": { "type": "string", "minLength": 1 },
        "ids": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "publishedAt": { "type": "string" }
      }
    },
    "tracks": { "type": "array", "minItems": 1 },
    "mixes": { "type": "array" },
    "sources": { "type": "array" }
  }
}
