{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drop-portal.blang81.chatgpt.site/schema/weekly-drop-v1",
  "title": "DROP:PORTAL Weekly Drop",
  "type": "object",
  "required": [
    "schemaVersion",
    "drop",
    "tracks",
    "mixes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "drop": {
      "type": "object",
      "required": [
        "id",
        "sequenceNumber",
        "period",
        "ids",
        "publishedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sequenceNumber": {
          "type": "integer",
          "minimum": 0
        },
        "period": {
          "type": "string",
          "minLength": 1
        },
        "ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "publishedAt": {
          "type": "string"
        }
      }
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/track"
      }
    },
    "mixes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mix"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^https://"
      }
    }
  },
  "$defs": {
    "link": {
      "type": "object",
      "required": [
        "kind",
        "url"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "preview": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "provider"
          ],
          "properties": {
            "kind": {
              "enum": [
                "direct-audio",
                "provider-embed"
              ]
            },
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "previewUrl": {
              "type": "string"
            },
            "waveformPeaksUrl": {
              "type": "string"
            },
            "embedUrl": {
              "type": "string",
              "pattern": "^https://"
            },
            "durationSec": {
              "type": "number",
              "minimum": 0
            },
            "usageBasis": {
              "type": "string"
            },
            "attribution": {
              "type": "string"
            }
          }
        }
      ]
    },
    "track": {
      "type": "object",
      "required": [
        "id",
        "artistName",
        "title",
        "reason",
        "subgenre",
        "release",
        "label",
        "releaseDate",
        "lane",
        "score",
        "confidence",
        "preview",
        "links"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "artistName": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "subgenre": {
          "type": "string",
          "minLength": 1
        },
        "release": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "releaseDate": {
          "type": "string",
          "pattern": "^\\\\d{4}-\\\\d{2}-\\\\d{2}$"
        },
        "lane": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "preview": {
          "$ref": "#/$defs/preview"
        },
        "links": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/link"
          }
        }
      }
    },
    "mix": {
      "type": "object",
      "required": [
        "id",
        "artistName",
        "title",
        "links"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "artistName": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string"
        },
        "preview": {
          "$ref": "#/$defs/preview"
        },
        "links": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/link"
          }
        }
      }
    }
  }
}

