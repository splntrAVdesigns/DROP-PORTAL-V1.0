{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DROP:PORTAL Weekly Publication Schedule",
  "type": "object",
  "required": ["schemaVersion", "timezone", "defaultSchedule", "override", "nextDropAt", "status", "updatedAt", "lastPublishedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "timezone": { "const": "America/Chicago" },
    "defaultSchedule": {
      "type": "object",
      "required": ["weekday", "time"],
      "properties": {
        "weekday": {
          "enum": ["SUNDAY", "MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY", "SATURDAY"]
        },
        "time": {
          "type": "string",
          "pattern": "^(?:[01]\\d|2[0-3]):00$"
        }
      },
      "additionalProperties": false
    },
    "override": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["mode", "date", "time"],
          "properties": {
            "mode": { "const": "one-off" },
            "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "time": { "type": "string", "pattern": "^(?:[01]\\d|2[0-3]):00$" }
          },
          "additionalProperties": false
        }
      ]
    },
    "nextDropAt": { "type": "string", "minLength": 20 },
    "status": { "enum": ["armed", "publishing", "paused"] },
    "updatedAt": { "type": ["string", "null"] },
    "lastPublishedAt": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
